POSTGRES_DB=ai_intel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-long-random-password
DATABASE_URL=postgres://postgres:change-me-to-a-long-random-password@localhost:5432/ai_intel
LOG_LEVEL=info
RAW_STORAGE_DIR=var/raw
FETCH_INTERVAL_MINUTES=15
# Raw payloads grow ~8-12 GB/month at 90 sources on hourly cadence. Keep this
# low unless raw_data lives on a dedicated volume with room to spare.
CRAWLED_DOCUMENT_TTL_DAYS=30
CRAWLED_DOCUMENT_CLEANUP_INTERVAL_MINUTES=1440
CRAWLED_DOCUMENT_CLEANUP_BATCH_SIZE=500
# Safety ceiling for one scoring run. The worker pages until the lookback
# window is scored or this ceiling is hit. Decider Flash scores every story;
# DeepSeek takes are only the daily top 10.
SCORING_MAX_DOCUMENTS_PER_RUN=20000
SCORING_LOOKBACK_DAYS=30
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~deepseek/deepseek-flash-latest
FEED_SHOW_WHY_RELEVANT=false
APP_BASE_URL=http://localhost:3000
APP_TIME_ZONE=America/Los_Angeles
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Michael's AI Brief
AUTH_ALLOWED_EMAILS=lianglingfan@gmail.com,e2e-smoke@example.com
ADMIN_EMAILS=lianglingfan@gmail.com
AUTH_SESSION_DAYS=30
BRAND_AUTHOR_NAME=Michael
BRAND_AUTHOR_BIO=AI engineering curation — high-signal papers, model releases, agent tooling, and inference infrastructure, with practical notes on why each story matters.
BRAND_X_URL=
BRAND_LINKEDIN_URL=
BRAND_GITHUB_URL=
E2E_TEST_EMAIL=e2e-smoke@example.com
E2E_TEST_PASSWORD=e2e-local-password-12345
