POSTGRES_DB=ai_intel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-long-random-password
DATABASE_URL=postgres://postgres:change-me-to-a-long-random-password@localhost:5432/ai_intel
LOG_LEVEL=info
RAW_STORAGE_DIR=var/raw
FETCH_INTERVAL_MINUTES=15
# Raw payloads grow ~8-12 GB/month at 90 sources on hourly cadence. Keep this
# low unless raw_data lives on a dedicated volume with room to spare.
CRAWLED_DOCUMENT_TTL_DAYS=30
CRAWLED_DOCUMENT_CLEANUP_INTERVAL_MINUTES=1440
CRAWLED_DOCUMENT_CLEANUP_BATCH_SIZE=500
SCORING_MAX_DOCUMENTS_PER_RUN=20
SCORING_LOOKBACK_DAYS=30
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
FEED_SHOW_WHY_RELEVANT=false
APP_BASE_URL=http://localhost:3000
APP_TIME_ZONE=America/Los_Angeles
AUTH_ALLOWED_EMAILS=lianglingfan@gmail.com,e2e-smoke@example.com
ADMIN_EMAILS=lianglingfan@gmail.com
AUTH_SESSION_DAYS=30
E2E_TEST_EMAIL=e2e-smoke@example.com
E2E_TEST_PASSWORD=e2e-local-password-12345
