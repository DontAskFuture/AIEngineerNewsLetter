{
  "name": "ai-builder-intelligence",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:web": "corepack pnpm --filter web dev",
    "dev:worker": "corepack pnpm --filter worker dev",
    "lint": "corepack pnpm --filter web lint",
    "typecheck": "corepack pnpm -r typecheck",
    "db:generate": "corepack pnpm --filter @ai-intel/db db:generate",
    "db:migrate": "corepack pnpm --filter @ai-intel/db db:migrate",
    "seed:sources": "corepack pnpm --filter worker seed:sources",
    "fetch:once": "corepack pnpm --filter worker fetch:once"
  }
}
